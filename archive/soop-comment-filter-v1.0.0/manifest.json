{
  "manifest_version": 3,
  "name": "SOOP 댓글 알림 필터",
  "version": "1.0.0",
  "description": "SOOP 알림창에서 댓글과 답글 알림을 중심으로 볼 수 있게 필터링합니다.",
  "content_scripts": [
    {
      "matches": [
        "https://www.sooplive.com/*",
        "https://*.sooplive.com/*"
      ],
      "js": [
        "src/classifier.js",
        "src/content.js"
      ],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
